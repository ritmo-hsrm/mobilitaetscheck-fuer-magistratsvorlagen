DOMAIN="localhost"
FRONTEND_HOST="http://localhost:5173"

# Database Settings
DB_HOSTNAME="localhost"
DB_NAME="mobilitaetscheck"
DB_USERNAME="mobilitaetscheck"
DB_PASSWORD="DB_PASSWORD"

ENVIRONMENT="production"

# Öffentlich erreichbare URL des Backends (ohne abschließenden Slash).
# Wird zum Erzeugen von Links in E-Mails sowie von URLs für hochgeladene
# Branding-Bilder (Logos, Favicon) verwendet. In Produktion auf die
# tatsächliche Domain setzen, z.B. "https://mobilitaetscheck.example.com".
HOST_URL="http://localhost:8000"

# Wurzelverzeichnis für alle Uploads (Branding-Bilder, Kommunen-PDF-Logos),
# relativ zum backend-Arbeitsverzeichnis. Hier ein persistentes Volume einbinden.
UPLOAD_DIR="./uploads"

JWT_SECRET_KEY="JWT_SECRET"
RESET_PASSWORD_TOKEN_SECRET ="RESET_SECRET"
VERIFICATION_TOKEN_SECRET="VERIFY_SECRET"
JWT_LIFETIME_SECONDS=43200

MAIL_USERNAME=username
MAIL_PASSWORD=password
MAIL_FROM=mail@example.com
MAIL_PORT=587
MAIL_SERVER=mail.example.com
MAIL_FROM_NAME="Mobilitaetscheck für Magistratsvorlagen"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

VITE_HOST_URL=http://localhost:8000
